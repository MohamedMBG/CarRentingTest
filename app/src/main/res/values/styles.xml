<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.CarRentingTest.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/homeCardStroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
    </style>

    <style name="Widget.CarRentingTest.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
    </style>

    <style name="Widget.CarRentingTest.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/homeCardStroke</item>
        <item name="android:textColor">@color/textColorPrimary</item>
    </style>

    <style name="Widget.CarRentingTest.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">@color/inputSurface</item>
        <item name="boxStrokeColor">@color/inputStroke</item>
        <item name="hintTextColor">@color/textColorSecondary</item>
    </style>

    <style name="Widget.CarRentingTest.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:textColorHint">@color/textColorSecondary</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="Widget.CarRentingTest.CheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="buttonTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/textColorSecondary</item>
    </style>

    <style name="Widget.CarRentingTest.Fab" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="tint">@color/colorOnPrimary</item>
    </style>

    <style name="ThemeOverlay.CarRentingTest.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Material3.BodyMedium</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Material3.TitleLarge</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CarRentingTest.PickerSurface</item>
    </style>

    <style name="Widget.CarRentingTest.BottomNavigation" parent="@style/Widget.Material3.BottomNavigationView">
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="itemIconSize">22dp</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.CarRentingTest.BottomNavigation.ActiveIndicator</item>
        <item name="itemRippleColor">@color/homeFilterRipple</item>
        <item name="itemPaddingTop">6dp</item>
        <item name="itemPaddingBottom">6dp</item>
    </style>

    <style name="Widget.CarRentingTest.BottomNavigation.ActiveIndicator">
        <item name="android:width">58dp</item>
        <item name="android:height">32dp</item>
        <item name="android:color">@color/homeChipBackground</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CarRentingTest.BottomNav.ActiveIndicator</item>
    </style>

    <style name="ShapeAppearance.CarRentingTest.BottomNav.ActiveIndicator" parent="@style/ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">16dp</item>
        <item name="cornerSizeBottomRight">16dp</item>
    </style>

    <style name="TextAppearance.CarRentingTest.BottomNav.Active" parent="@style/TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <style name="TextAppearance.CarRentingTest.BottomNav.Inactive" parent="@style/TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textFontWeight">500</item>
    </style>


    <style name="ShapeAppearanceOverlay.CarRentingTest.Circle" parent="@style/ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ThemeOverlay.CarRentingTest.DatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="materialCalendarStyle">@style/Widget.CarRentingTest.MaterialDatePicker</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.CarRentingTest.PickerSurface</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.CarRentingTest.PickerSurface</item>
    </style>

    <style name="Widget.CarRentingTest.MaterialDatePicker" parent="Widget.Material3.MaterialCalendar">
        <item name="daySelectedStyle">@style/Widget.CarRentingTest.MaterialDatePicker.DaySelected</item>
        <item name="dayTodayStyle">@style/Widget.CarRentingTest.MaterialDatePicker.DayToday</item>
        <item name="dayStyle">@style/Widget.CarRentingTest.MaterialDatePicker.Day</item>
    </style>

    <style name="Widget.CarRentingTest.MaterialDatePicker.DaySelected" parent="Widget.Material3.MaterialCalendar.Day.Selected">
        <item name="itemFillColor">@color/colorPrimary</item>
        <item name="itemTextColor">@color/colorOnPrimary</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.CarRentingTest.PickerDay</item>
    </style>

    <style name="Widget.CarRentingTest.MaterialDatePicker.DayToday" parent="Widget.Material3.MaterialCalendar.Day.Today">
        <item name="itemStrokeColor">@color/colorPrimary</item>
        <item name="itemTextColor">@color/textColorPrimary</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.CarRentingTest.PickerDay</item>
    </style>

    <style name="Widget.CarRentingTest.MaterialDatePicker.Day" parent="Widget.Material3.MaterialCalendar.Day">
        <item name="itemTextColor">@color/textColorPrimary</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.CarRentingTest.PickerDay</item>
    </style>

    <style name="ShapeAppearance.CarRentingTest.PickerSurface" parent="@style/ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.CarRentingTest.PickerDay" parent="@style/ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ThemeOverlay.CarRentingTest.TimePicker" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.CarRentingTest.PickerSurface</item>
        <item name="materialTimePickerStyle">@style/Widget.CarRentingTest.MaterialTimePicker</item>
    </style>

    <style name="Widget.CarRentingTest.MaterialTimePicker" parent="Widget.Material3.MaterialTimePicker">
        <item name="clockFaceBackgroundColor">@color/homeChipBackground</item>
        <item name="clockHandColor">@color/colorPrimary</item>
        <item name="clockNumberTextColor">@color/textColorPrimary</item>
    </style>
</resources>
